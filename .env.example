# Copy to .env for local overrides. Never commit .env or credentials.
FRAUD_API_APP_ENV=development
FRAUD_API_ENABLE_DOCS=true
FRAUD_API_HOST=127.0.0.1
FRAUD_API_PORT=8000
FRAUD_API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRAUD_API_DATABASE_PATH=data/backend/mission04.sqlite3
FRAUD_API_UPLOAD_DIRECTORY=data/uploads
FRAUD_API_MAX_JSON_BODY_BYTES=2097152
FRAUD_API_MAX_UPLOAD_BYTES=33554432
FRAUD_API_MAX_CSV_ROWS=20000
FRAUD_API_CSV_CHUNK_ROWS=256
FRAUD_API_MAX_BATCH_ROWS=1000
FRAUD_API_MAX_EXPLANATION_BATCH=25
FRAUD_API_MAX_CONCURRENT_ANALYSES=1
FRAUD_API_MAX_PAGE_SIZE=100
FRAUD_API_UPLOAD_RETENTION_HOURS=24
